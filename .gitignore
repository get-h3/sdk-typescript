node_modules/
dist/
.vitest/
coverage/

# Hilo — local graph cache (rebuildable); .vfs/.dirty and manifest.yaml are intentional
.vfs/graph/

# GitReins configuration is tracked; runtime state is local-only
.gitreins/tasks.yaml
.gitreins/history/
.gitreins/logs/
.gitreins/usage.jsonl
.schemas-changed

# npm/package-lock.json is authoritative; reject local pnpm metadata
pnpm-lock.yaml
pnpm-workspace.yaml
.coding-hermes/board/board.db
.coding-hermes/board/board.jsonl
.coding-hermes/board/*.parquet

# Stray dagger sandbox DB and SQLite sidecars (not part of this repo)
dagger.db*

# Agent/namespace writers must never land in a product repo (GAP-061): a
# DuckBrain-style namespaces/<ns>/ tree was auto-committed here by an agent
# whose CWD resolved to this checkout. Guard, not a licence — the writer's
# output path must stay on the lane workdir.
namespaces/

.coding-hermes/board/board.db.wal
.coding-hermes/board/*.duckdb
